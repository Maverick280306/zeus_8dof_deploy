<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zeus</name>
  <version>1.0.0</version>
  <description>Metapackage: everything the Raspberry Pi runs for Zeus.</description>
  <maintainer email="vismayshah121@gmail.com">vismay</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>zeus_msgs</exec_depend>
  <exec_depend>zeus_link</exec_depend>
  <exec_depend>zeus_rerun</exec_depend>
  <exec_depend>zeus_control_interface</exec_depend>
  <exec_depend>zeus_description</exec_depend>
  <exec_depend>mukesh_description</exec_depend>
  <exec_depend>zeus_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
